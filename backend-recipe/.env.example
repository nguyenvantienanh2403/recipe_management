# =====================================================
# Backend Environment Variables
# Copy file này thành application.properties và sửa giá trị
# =====================================================

# PostgreSQL Database
DB_URL=jdbc:postgresql://localhost:5432/recipe_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT
JWT_ISSUER=recipe-app
JWT_PUBLIC_KEY=publicKey.pem
JWT_PRIVATE_KEY=privateKey.pem

# Server
SERVER_PORT=8080

# Frontend URL (cho CORS)
FRONTEND_URL=http://localhost:5173
